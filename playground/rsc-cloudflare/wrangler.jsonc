{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rsc-test-demo",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "DemoWorkspace" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DemoWorkspace"] }]
}
