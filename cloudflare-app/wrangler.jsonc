{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "candidate-tracker-test-demo",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "alias": { "zod": "./node_modules/zod/index.js" },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": { "RSC_SIMULATOR_TOKEN": "rsc-local-test-token" },
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "TrackerWorkspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TrackerWorkspace"] }]
}
