{
  "name": "candidate-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19 <25"
  },
  "workspaces": [
    "web",
    "api"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @candidate-tracker/web",
    "dev:api": "npm run dev --workspace @candidate-tracker/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace @candidate-tracker/web",
    "build:api": "npm run build --workspace @candidate-tracker/api",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @candidate-tracker/api",
    "check": "npm run lint && npm test && npm run build",
    "prisma:generate": "npm run prisma:generate --workspace @candidate-tracker/api",
    "prisma:migrate": "npm run prisma:migrate --workspace @candidate-tracker/api --",
    "prisma:deploy": "npm run prisma:deploy --workspace @candidate-tracker/api",
    "db:start": "npm exec --workspace @candidate-tracker/api -- tsx ../local-db/start.ts",
    "db:seed": "npm exec --workspace @candidate-tracker/api -- tsx ../local-db/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.3",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.59.2"
  }
}
